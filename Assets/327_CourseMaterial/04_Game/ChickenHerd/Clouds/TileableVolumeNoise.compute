// Unity adaptation of sebh/TileableVolumeNoise (MIT).
// See LICENSE.txt and README.md in this folder.
#pragma kernel Generate

RWTexture3D<float4> Result;
int Resolution;

float Hash(float n)
{
    return frac(sin(n + 1.951) * 43758.5453);
}

float ValueNoise(float3 p)
{
    float3 cell = floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    float n = cell.x + cell.y * 57.0 + cell.z * 113.0;
    return lerp(lerp(lerp(Hash(n), Hash(n + 1.0), f.x),
                     lerp(Hash(n + 57.0), Hash(n + 58.0), f.x), f.y),
                lerp(lerp(Hash(n + 113.0), Hash(n + 114.0), f.x),
                     lerp(Hash(n + 170.0), Hash(n + 171.0), f.x), f.y), f.z);
}

float3 Wrap(float3 p, float period)
{
    return p - floor(p / period) * period;
}

float WorleyNoise(float3 p, float cells)
{
    p *= cells;
    float distanceSquared = 1.0;
    for (int x = -1; x <= 1; x++)
    for (int y = -1; y <= 1; y++)
    for (int z = -1; z <= 1; z++)
    {
        float3 cell = floor(p) + float3(x, y, z);
        float3 distance = p - cell - ValueNoise(Wrap(cell, cells));
        distanceSquared = min(distanceSquared, dot(distance, distance));
    }
    return saturate(distanceSquared);
}

float3 Gradient(float3 cell)
{
    float n = cell.x + cell.y * 57.0 + cell.z * 113.0;
    return normalize(float3(Hash(n), Hash(n + 19.0), Hash(n + 47.0)) * 2.0 - 1.0);
}

// Periodic 3D gradient Perlin, replacing the original GLM 4D call.
float PerlinNoise(float3 p, float frequency)
{
    p *= frequency;
    float3 cell = floor(p);
    float3 f = frac(p);
    float3 fade = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float sum = 0.0;
    for (int x = 0; x <= 1; x++)
    for (int y = 0; y <= 1; y++)
    for (int z = 0; z <= 1; z++)
    {
        float3 offset = float3(x, y, z);
        float3 weight = lerp(1.0 - fade, fade, offset);
        sum += dot(Gradient(Wrap(cell + offset, frequency)), f - offset) * weight.x * weight.y * weight.z;
    }
    return sum;
}

float PerlinFBM(float3 p)
{
    float sum = 0.0;
    float weight = 0.5;
    float weightSum = 0.0;
    float frequency = 4.0;
    for (int octave = 0; octave < 3; octave++)
    {
        sum += PerlinNoise(p, frequency) * weight;
        weightSum += weight;
        weight *= weight;
        frequency *= 2.0;
    }
    return saturate(sum / weightSum * 0.5 + 0.5);
}

float4 CloudNoise(float3 p)
{
    float worley0 = 1.0 - WorleyNoise(p, 4.0);
    float worley1 = 1.0 - WorleyNoise(p, 8.0);
    float worley2 = 1.0 - WorleyNoise(p, 16.0);
    float worleyFBM = worley0 * 0.625 + worley1 * 0.25 + worley2 * 0.125;
    float perlinWorley = lerp(worleyFBM, 1.0, PerlinFBM(p));
    return float4(perlinWorley, worleyFBM, worley1, 1.0);
}

[numthreads(8, 8, 8)]
void Generate(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint)Resolution)) return;
    Result[id] = CloudNoise((id + 0.5) / (float)Resolution);
}
